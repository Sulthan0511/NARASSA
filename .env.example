# ===========================================================================
#  NARASSA — CONTOH FILE ENVIRONMENT (.env.example)
# ===========================================================================
#  CARA PAKAI (lokal):
#    1. Salin file ini menjadi `.env.local` di root proyek  (untuk `npm run dev`)
#    2. Isi nilai sesuai instruksi README.md bagian "Sambungkan Supabase".
#    3. `.env*` sudah masuk .gitignore -> TIDAK ikut ter-upload ke GitHub.
#
#  CARA PAKAI (Vercel / production):
#    Project Vercel -> Settings -> Environment Variables -> tambahkan 3 kunci
#    ini dengan nilai yang sama (Production & Preview).
# ===========================================================================

# URL project Supabase  (Supabase Dashboard -> Project Settings -> API)
# Contoh: https://abcdefghij.supabase.co
SUPABASE_URL=

# SERVICE ROLE KEY (bukan anon key!) -> akses penuh dari server, RAHASIA.
# Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Kunci tanda tangan session login (bebas teks acak, jangan dipublikasikan)
SESSION_SECRET=ganti-dengan-teks-acak-punyamu
